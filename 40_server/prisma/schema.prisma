// MyFamily Hub — PostgreSQL schema (from 10_docs/기획서.md)
// Auth / family sharing (`is_shared`) is modeled here; API wiring comes next.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MEMBER
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Family {
  id         Int      @id @default(autoincrement())
  familyName String   @map("family_name") @db.VarChar(100)
  inviteCode String   @unique @map("invite_code") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")

  users            User[]
  inviteTokens     InviteToken[]
  assets           Asset[]
  documents        Document[]
  subscriptions    Subscription[]
  transactions     Transaction[]
  photos           Photo[]
  calendarEvents   CalendarEvent[]
  checklists       Checklist[]
  recurringDeposits RecurringDeposit[]
  activities       FamilyActivity[]
  icloudAlbums     FamilyIcloudAlbum[]

  @@map("families")
}

model FamilyIcloudAlbum {
  id           Int       @id @default(autoincrement())
  familyId     Int       @map("family_id")
  url          String    @db.VarChar(500)
  name         String?   @db.VarChar(200)
  /// When true, opening the album does not overwrite `name` from iCloud.
  nameLocked   Boolean   @default(false) @map("name_locked")
  coverPhotoId String?   @map("cover_photo_id") @db.VarChar(120)
  coverMime    String?   @map("cover_mime") @db.VarChar(80)
  /// Last known photo count; null until the album has been opened once.
  photoCount   Int?      @map("photo_count")
  syncedAt     DateTime? @map("synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  family       Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, url])
  @@index([familyId])
  @@map("family_icloud_albums")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(100)
  familyId     Int?     @map("family_id")
  role         UserRole @default(MEMBER)
  languagePref String   @default("ko") @map("language_pref") @db.VarChar(10)
  countryPref  String   @default("JP") @map("country_pref") @db.VarChar(10)
  /// Display currency for dashboard / subscriptions (KRW | JPY | USD)
  currencyPref String   @default("JPY") @map("currency_pref") @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at")

  family           Family?         @relation(fields: [familyId], references: [id], onDelete: SetNull)
  passkeys         PasskeyCredential[]
  inviteTokensCreated InviteToken[] @relation("InviteTokenCreatedBy")
  inviteTokensUsed    InviteToken[] @relation("InviteTokenUsedBy")
  assets           Asset[]
  documents        Document[]
  subscriptions    Subscription[]
  transactions     Transaction[]
  photos           Photo[]
  calendarEvents   CalendarEvent[]
  checklists       Checklist[]
  recurringDeposits RecurringDeposit[]
  pushSubscriptions PushSubscription[]
  activitiesActed   FamilyActivity[]     @relation("FamilyActivityActor")
  activityReads     FamilyActivityRead[]

  @@index([familyId])
  @@map("users")
}

model Asset {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  familyId   Int?     @map("family_id")
  /// deposit | stock | cash | account | realestate | ...
  type       String   @db.VarChar(50)
  /// Display name (e.g. bank account label)
  label      String   @db.VarChar(200)
  currency   String   @db.VarChar(10)
  amount     Decimal  @db.Decimal(15, 2)
  /// Deposit bank: SHINHAN | MUFG | YUCHO
  bankCode   String?  @map("bank_code") @db.VarChar(20)
  /// Bank account number (plaintext; visible to viewers of this asset)
  accountNumber String? @map("account_number") @db.VarChar(64)
  /// AES-256-GCM ciphertext (base64url). Never returned from list/CRUD APIs.
  loginPasswordCipher String? @map("login_password_cipher") @db.Text
  /// KR | JP | US — used to resolve Yahoo Finance symbols
  stockMarket String? @map("stock_market") @db.VarChar(10)
  stockCode  String?  @map("stock_code") @db.VarChar(32)
  /// Shares / units for stock assets
  quantity   Decimal? @db.Decimal(18, 6)
  /// Average buy price per share
  buyPrice   Decimal? @map("buy_price") @db.Decimal(15, 4)
  /// Last fetched market price per share
  currentPrice Decimal? @map("current_price") @db.Decimal(15, 4)
  isShared   Boolean  @default(false) @map("is_shared")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  family       Family?       @relation(fields: [familyId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  recurringDeposits RecurringDeposit[]

  @@index([userId])
  @@index([familyId])
  @@index([isShared])
  @@map("assets")
}

/// Automatic periodic credit into a deposit asset (e.g. 育児手当)
model RecurringDeposit {
  id              Int             @id @default(autoincrement())
  userId          Int             @map("user_id")
  familyId        Int?            @map("family_id")
  assetId         Int             @map("asset_id")
  label           String          @db.VarChar(200)
  amount          Decimal         @db.Decimal(15, 2)
  currency        String          @db.VarChar(10)
  billingInterval BillingInterval @default(MONTHLY) @map("billing_interval")
  /// Month of year (1–12). Required when billingInterval is YEARLY.
  billingMonth    Int?            @map("billing_month")
  /// Day of month (1–31)
  billingDate     Int             @map("billing_date")
  isActive        Boolean         @default(true) @map("is_active")
  /// Last calendar date a credit was applied (UTC date)
  lastAppliedOn   DateTime?       @map("last_applied_on") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  asset  Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([assetId])
  @@index([isActive])
  @@map("recurring_deposits")
}

model Document {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  familyId   Int?      @map("family_id")
  /// Free-text label, e.g. 신한 Visa, さくらクリニック
  docType    String    @map("doc_type") @db.VarChar(50)
  /// medical | card | id | insurance | certificate | other
  category   String    @default("other") @db.VarChar(50)
  docNumber  String?   @map("doc_number") @db.VarChar(100)
  /// JSON array of { id, label, isSecret, valueCipher?, valuePlain? }
  fieldsJson String?   @map("fields_json") @db.Text
  expiryDate DateTime? @map("expiry_date") @db.Date
  imageUrl   String?   @map("image_url") @db.Text
  isShared   Boolean   @default(false) @map("is_shared")
  memo       String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")

  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  family               Family?         @relation(fields: [familyId], references: [id], onDelete: SetNull)
  calendarExpiryEvents CalendarEvent[]

  @@index([userId])
  @@index([familyId])
  @@index([expiryDate])
  @@index([category])
  @@map("documents")
}

model Subscription {
  id          Int     @id @default(autoincrement())
  userId      Int     @map("user_id")
  familyId    Int?    @map("family_id")
  serviceName String  @map("service_name") @db.VarChar(100)
  cost        Decimal @db.Decimal(10, 2)
  currency    String  @db.VarChar(10)
  /// MONTHLY = day-of-month; YEARLY = month + day
  billingInterval BillingInterval @default(MONTHLY) @map("billing_interval")
  /// Month of year (1–12). Required when billingInterval is YEARLY.
  billingMonth Int?   @map("billing_month")
  /// Day of month (1–31)
  billingDate Int     @map("billing_date")
  /// Shared service login (e.g. Netflix email). Visible to viewers of this subscription.
  loginId     String? @map("login_id") @db.VarChar(255)
  /// AES-256-GCM ciphertext (base64url). Never returned from list/CRUD APIs.
  loginPasswordCipher String? @map("login_password_cipher") @db.Text
  cancelUrl   String? @map("cancel_url") @db.Text
  reason      String? @db.Text
  isShared    Boolean @default(false) @map("is_shared")
  createdAt   DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
  @@index([billingDate])
  @@index([billingInterval])
  @@map("subscriptions")
}

model Transaction {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  familyId     Int?     @map("family_id")
  assetId      Int?     @map("asset_id")
  /// credit = deposit/income, debit = withdrawal/expense
  category     String   @db.VarChar(50)
  amount       Decimal  @db.Decimal(15, 2)
  currency     String   @db.VarChar(10)
  date         DateTime @db.Date
  description  String?  @db.Text
  balanceAfter Decimal? @map("balance_after") @db.Decimal(15, 2)
  isShared     Boolean  @default(false) @map("is_shared")
  createdAt    DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  asset  Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([assetId])
  @@index([date])
  @@map("transactions")
}

model Photo {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  familyId      Int?     @map("family_id")
  photoUrl      String   @map("photo_url") @db.Text
  icloudAssetId String?  @map("icloud_asset_id") @db.VarChar(255)
  caption       String?  @db.Text
  isShared      Boolean  @default(false) @map("is_shared")
  createdAt     DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
  @@map("photos")
}

model CalendarEvent {
  id                    Int      @id @default(autoincrement())
  userId                Int      @map("user_id")
  familyId              Int?     @map("family_id")
  title                 String   @db.VarChar(200)
  description           String?  @db.Text
  /// Floating wall-clock stored as UTC components (HH:mm via setUTCHours). Process TZ must be UTC.
  startTime             DateTime @map("start_time") @db.Timestamptz(3)
  endTime               DateTime @map("end_time") @db.Timestamptz(3)
  isAllDay              Boolean  @default(false) @map("is_all_day")
  /// personal | family | holiday | document_expiry
  category              String   @default("personal") @db.VarChar(50)
  sourceDocumentId      Int?     @map("source_document_id")
  reminderMinutesBefore Int?     @map("reminder_minutes_before")
  isReminderSent        Boolean  @default(false) @map("is_reminder_sent")
  /// YYYY-MM-DD of the occurrence last notified (recurring events)
  reminderSentFor       String?  @map("reminder_sent_for") @db.VarChar(32)
  isShared              Boolean  @default(false) @map("is_shared")
  /// RecurrenceRule JSON: { freq, interval, byWeekday?, monthMode?, bySetPos?, until?, count? }
  recurrence            Json?
  createdAt             DateTime @default(now()) @map("created_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  family         Family?   @relation(fields: [familyId], references: [id], onDelete: SetNull)
  sourceDocument Document? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
  @@index([startTime])
  @@index([category])
  @@index([sourceDocumentId])
  @@map("calendar_events")
}

model Checklist {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  familyId  Int?     @map("family_id")
  title     String   @db.VarChar(200)
  isShared  Boolean  @default(false) @map("is_shared")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family?         @relation(fields: [familyId], references: [id], onDelete: SetNull)
  items  ChecklistItem[]

  @@index([userId])
  @@index([familyId])
  @@index([isShared])
  @@map("checklists")
}

model ChecklistItem {
  id          Int       @id @default(autoincrement())
  checklistId Int       @map("checklist_id")
  parentId    Int?      @map("parent_id")
  title       String    @db.VarChar(300)
  sortOrder   Int       @default(0) @map("sort_order")
  /// Set when checked off; kept in list until auto-purged (~30 days).
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  checklist Checklist       @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  parent    ChecklistItem?  @relation("ChecklistItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ChecklistItem[] @relation("ChecklistItemTree")

  @@index([checklistId])
  @@index([parentId])
  @@index([completedAt])
  @@map("checklist_items")
}

model PasskeyCredential {
  id         String   @id @db.VarChar(512)
  userId     Int      @map("user_id")
  publicKey  Bytes    @map("public_key")
  counter    BigInt   @default(0)
  deviceType String?  @map("device_type") @db.VarChar(32)
  backedUp   Boolean  @default(false) @map("backed_up")
  transports String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

model InviteToken {
  id              Int       @id @default(autoincrement())
  familyId        Int       @map("family_id")
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  usedByUserId    Int?      @map("used_by_user_id")
  createdByUserId Int       @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User   @relation("InviteTokenCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  usedBy    User?  @relation("InviteTokenUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([expiresAt])
  @@map("invite_tokens")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  endpoint  String   @unique @db.Text
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

enum FamilyActivityEntityType {
  CALENDAR_EVENT
  DOCUMENT
  CHECKLIST
  ASSET
  SUBSCRIPTION
  PHOTO
}

model FamilyActivity {
  id          Int                      @id @default(autoincrement())
  familyId    Int                      @map("family_id")
  actorUserId Int                      @map("actor_user_id")
  entityType  FamilyActivityEntityType @map("entity_type")
  entityId    Int                      @map("entity_id")
  title       String                   @db.VarChar(200)
  createdAt   DateTime                 @default(now()) @map("created_at")

  family Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actor  User                 @relation("FamilyActivityActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  reads  FamilyActivityRead[]

  @@index([familyId, createdAt])
  @@index([entityType, entityId])
  @@map("family_activities")
}

model FamilyActivityRead {
  id         Int      @id @default(autoincrement())
  activityId Int      @map("activity_id")
  userId     Int      @map("user_id")
  readAt     DateTime @default(now()) @map("read_at")

  activity FamilyActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([userId])
  @@map("family_activity_reads")
}
