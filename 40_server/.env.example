# Local / Cloud Agent / dig Postgres
DATABASE_URL=postgresql://myfamilyhub:change_me_dig@127.0.0.1:5432/myfamilyhub?schema=public

# JWT for /api/auth and /api/family (change in production)
JWT_SECRET=dev-secret-change-me

# WebAuthn (dig example — adjust for prod domain)
# WEBAUTHN_RP_ID=sumicchogurashi-dev.duckdns.org
# WEBAUTHN_ORIGIN=https://sumicchogurashi-dev.duckdns.org

# Existing JSON task store (starter API)
# DATA_FILE=../../30_data/tasks.json
PORT=3001

# Set to 1 only for ephemeral in-memory auth (Passkeys lost on restart)
# MEMORY_AUTH=0
