# Local / Cloud Agent Postgres (see docker-compose.dev.yml)
DATABASE_URL=postgresql://myfamilyhub:change_me@localhost:5432/myfamilyhub?schema=public

# JWT for /api/auth and /api/family (change in production)
JWT_SECRET=dev-secret-change-me

# Existing JSON task store (starter API) — optional once domain APIs replace it
# DATA_FILE=../../30_data/tasks.json
PORT=3001
