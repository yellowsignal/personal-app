# Production API env — copy to .env.prod on the OCI host (never commit .env.prod).
# Dig keeps using .env on port 5432; prod uses this file + Postgres on 5433.

DATABASE_URL=postgresql://myfamilyhub:change_me_prod@127.0.0.1:5433/myfamilyhub?schema=public
POSTGRES_PASSWORD=change_me_prod

# Must match dig if you restore dig DB and need subscription password decrypt to keep working.
JWT_SECRET=change-me-prod-jwt
# Optional: set explicitly (64 hex chars). If unset, derived from JWT_SECRET.
# CREDENTIALS_ENCRYPTION_KEY=

# WebAuthn — prod domain only (dig Passkeys do NOT work here; re-register after cutover)
WEBAUTHN_RP_ID=sumicchogurashi.duckdns.org
WEBAUTHN_ORIGIN=https://sumicchogurashi.duckdns.org
WEBAUTHN_RP_NAME=すみっチョぐらし

# Web Push — after clone-dig-to-prod, copy dig vapid.json so stored subscriptions still match
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@sumicchogurashi.duckdns.org
PUBLIC_APP_ORIGIN=https://sumicchogurashi.duckdns.org

# File stores (separate from dig under 30_data/)
# PHOTO_DIR / DOCUMENT_SCAN_DIR / ICLOUD_COVER_DIR / DATA_FILE are set by systemd in setup-prod-postgres.sh

# Do not set PORT here — systemd sets PORT=3001
