# PostgreSQL
POSTGRES_USER=myfamilyhub
POSTGRES_PASSWORD=change_me
POSTGRES_DB=myfamilyhub

# Temporary domain (DuckDNS). Safe to rename later.
# Note: DuckDNS has no nested names like dev.foo.duckdns.org — use a second subdomain.
DOMAIN=sumicchogurashi.duckdns.org
DEV_DOMAIN=sumicchogurashi-dev.duckdns.org
LETSENCRYPT_EMAIL=your-email@example.com

# DuckDNS token from https://www.duckdns.org (keep private — put only in .env)
DUCKDNS_TOKEN=replace_me
DUCKDNS_SUBDOMAIN=sumicchogurashi
DUCKDNS_DEV_SUBDOMAIN=sumicchogurashi-dev
